 Ny = 3, Nz = 2;\n\n    // Allocate a flat array of size Nx * Ny * Nz\n    float *A = malloc(Nx * Ny * Nz * sizeof(float));\n\n    // Fill the array using lexicographic index\n    for (int i = 0; i < Nx; i++) {\n        for (int j = 0; j < Ny; j++) {\n            for (int k = 0; k < Nz; k++) {\n                int index = i * (Ny * Nz) + j * Nz + k;\n                A[index] = (float)(i + j + k);  // Example value\n            }\n        }\n    }\n\n    // Print a few values\n    for (int i = 0; i < Nx; i++) {\n        for (int j = 0; j < Ny; j++) {\n            for (int k = 0; k < Nz; k++) {\n                int index = i * (Ny * Nz) + j * Nz + k;\n                printf(\"A[%d][%d][%d] = %f\\n\", i, j, k, A[index]);\n            }\n        }\n    }\n\n    free(A);\n    return 0;\n}","position":{"start":{"line":87,"column":1},"end":{"line":120,"column":1}},"key":"E1QE6YE1at"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Output (truncated for clarity)","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"NdT9tA7GY1"}],"key":"sXskU8aYXg"},{"type":"code","lang":"","value":"A[0][0][0] = 0.000000\nA[0][0][1] = 1.000000\nA[0][1][0] = 1.000000\nA[0][1][1] = 2.000000\n...\nA[3][2][1] = 6.000000","position":{"start":{"line":122,"column":1},"end":{"line":129,"column":1}},"key":"Wi2bA8B57J"}],"key":"qqU8M3qmhZ"}],"key":"OcMF3FT3YL"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Pointers and Arrays","url":"/c-arrays-and-pointers-1","group":"The C Programming Language Basics"},"next":{"title":"Summary","url":"/summary-1","group":"The C Programming Language Basics"}}},"domain":"http://localhost:3000"}