ext","value":"A typical use case is when you want to launch a graphical user interface (GUI) program from the terminal, and be able to still using the terminal (to launch other programs, check outputs and so on). Suppose the GUI program is called ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"FrekgBYasN"},{"type":"inlineCode","value":"myprogram","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"DlN1dGKdgb"},{"type":"text","value":" , then by putting an ampersand ( ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"DQE3AFSTqC"},{"type":"inlineCode","value":"&","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"QcQ4M9vPAb"},{"type":"text","value":" ) symbol at the end, it will go directly to background, letting you able to use the terminal.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"zGhL9xSaF7"}],"key":"lrL91yuAyd"},{"type":"code","lang":"bash","value":"> myprogram &  # this will open a window\n> ls           # we can still use the terminal\nApplications    Documents","position":{"start":{"line":9,"column":1},"end":{"line":13,"column":1}},"key":"AdAMSYsWhO"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Mind that if ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"dHLdp2CsyG"},{"type":"inlineCode","value":"myprogram","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"Pm4BIgMT5r"},{"type":"text","value":" is sending output to the terminal, it will overlap with what you see in your shell. If it keeps producing output, you might not be able to see what you are typing! The way to go around this is to redirect the output either to a file","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"xngVMCPTi5"}],"key":"iHZkCdAZiF"},{"type":"code","lang":"bash","value":"> myprogram > log &  # this will place all output in the file called log\n> ls           # we can still use the terminal\nApplications    Documents","position":{"start":{"line":18,"column":1},"end":{"line":22,"column":1}},"key":"yGNCBH3q2R"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"or to the special file ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"ZY8C9CV6GL"},{"type":"inlineCode","value":"/dev/null","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"N1z6ooe9ES"},{"type":"text","value":" , which discards the output","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"cKwvPHDosb"}],"key":"zAitiY7mG3"},{"type":"code","lang":"bash","value":"> myprogram > /dev/null &  # this will discard all output\n> ls           # we can still use the terminal\nApplications    Documents","position":{"start":{"line":27,"column":1},"end":{"line":31,"column":1}},"key":"GXDSvun2W0"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Note that unix systems have a different type of output channel, besides ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"ANneWmLunR"},{"type":"inlineCode","value":"stdout","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"iVuFCaQgH5"},{"type":"text","value":" , which is called the standard error ( ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"spOsbv8B3p"},{"type":"inlineCode","value":"stderr","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"JNf4zjY4UG"},{"type":"text","value":" ). It will still end up in your terminal’s output. So, you might want to catch or get rid of it as well. The way to do it is to first redirect ","position":{"start":{"line":34,"column":1},"end":