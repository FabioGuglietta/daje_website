ype":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"You can put it into background, so that it will keep running (sleep does nothing, but this is just an example...) while you are free to use the terminal","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"BfesNpKAnV"}],"key":"xUVPhrvKPg"},{"type":"code","lang":"bash","value":"> bg 1\n[1]+ sleep 100000 &\n> ls\nApplications   Documents\n>","position":{"start":{"line":55,"column":1},"end":{"line":61,"column":1}},"key":"AldNgcpvvd"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"And you can put it back in foreground with ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"LUVF6cJCOz"},{"type":"inlineCode","value":"fg","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"LNbMYUCOey"}],"key":"RvxoELuI3J"},{"type":"code","lang":"bash","value":"> fg 1\nsleep 100000","position":{"start":{"line":66,"column":1},"end":{"line":69,"column":1}},"key":"sOtU3PG9IB"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"To cancel a job in foreground, hit ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"T4GTdJPU6u"},{"type":"inlineCode","value":"ctrl+c","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"h0Dni4FLdt"}],"key":"Uhmw4mxYa1"},{"type":"code","lang":"bash","value":"> fg 1\nsleep 100000\n^C\n>","position":{"start":{"line":74,"column":1},"end":{"line":79,"column":1}},"key":"kz0s338E1i"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"You can see the list of jobs currently handled by your shell using the ","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1