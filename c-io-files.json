{"version":3,"kind":"Article","sha256":"9c5ca98ff1fc0f1545e6524f0e736377b4545fd214eb1b00ac8e2de096fb2813","slug":"c-io-files","location":"/src/1-Fundamentals/300-The_C_programming_language_basics/11-C_IO_files.md","dependencies":[],"frontmatter":{"title":"File Input/Output: Reading and Writing Files","content_includes_title":false,"numbering":{"title":{"offset":2}},"exports":[{"format":"md","filename":"11-C_IO_files.md","url":"/daje_website/build/11-C_IO_files-8bf07f4dae426915eb3f79405a8337ab.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Suppose a text file contains the coordinates of points belonging to a particle.\nEach point has an identifier and three coordinates. We want to read the points,\ncalculate their centroid, and write the result to another file.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iY43iNX2G0"}],"key":"bZ5b5kkIlf"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The input file has this format:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"NrVZwbcTk7"}],"key":"Zvr8BXYjwH"},{"type":"code","lang":"text","value":"number_of_points dataset_name\npoint_id x y z\npoint_id x y z\n...","position":{"start":{"line":9,"column":1},"end":{"line":14,"column":1}},"key":"SV1l4dY9iM"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"For example, ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"wu36uGpuxn"},{"type":"inlineCode","value":"points.txt","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"m45GW7QUHB"},{"type":"text","value":" could contain:","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"iTw9Xo7FUX"}],"key":"GSjslRpVYM"},{"type":"code","lang":"text","value":"4 Particle_A\n1 1.0 2.0 3.0\n2 4.0 5.0 6.0\n3 7.0 8.0 9.0\n4 10.0 11.0 12.0","position":{"start":{"line":18,"column":1},"end":{"line":24,"column":1}},"key":"PYXJMpd88k"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Since all points have equal weight, their centroid is the coordinate-wise\naverage, ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"vTlgtb32gx"},{"type":"inlineCode","value":"(5.5, 6.5, 7.5)","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ah1FVCC5LV"},{"type":"text","value":".","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ULg52CgBfc"}],"key":"YVIqY8zMab"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Run the program with the input and output filenames:","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"zCgtdsyaow"}],"key":"dDJFsCG9EB"},{"type":"code","lang":"bash","value":"./centroid points.txt results.txt","position":{"start":{"line":31,"column":1},"end":{"line":33,"column":1}},"key":"NnHseK8keS"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"The program reads the point count and checks that it is positive. It assumes\nthe remaining point records follow the format shown above, computes the\ncentroid, and writes the results to the output file.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"r5uUPw6Run"}],"key":"IROMCbWKAV"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Algorithm","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"SGttnuzQI1"}],"identifier":"algorithm","label":"Algorithm","html_id":"algorithm","implicit":true,"key":"AXQ6dUBwWD"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Before looking at the C implementation, here is the sequence of steps:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"bf8DoxWRpI"}],"key":"GswLpYdz1v"},{"type":"code","lang":"text","value":"READ the input filename and output filename from the command line\nOPEN the input file\nREAD the number of points and the dataset name\nALLOCATE one array for identifiers and three arrays for coordinates\nFOR each point\n    READ its identifier into points_id\n    READ its coordinates into points_x, points_y, points_z\nEND FOR\nCLOSE the input file\ncentroid_x = AVERAGE(points_x)\ncentroid_y = AVERAGE(points_y)\ncentroid_z = AVERAGE(points_z)\nOPEN the output file\nWRITE the dataset name, point count, centroid, and coordinates\nCLOSE the output file\nRELEASE the four arrays","position":{"start":{"line":43,"column":1},"end":{"line":60,"column":1}},"key":"pNPHz1qbCt"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"The code below follows this order. For clarity, it checks the command-line\narguments, file openings, header, and memory allocation. It assumes that the\nremaining point records follow the format shown above.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"iUaZon94pX"}],"key":"bgxODk8nbW"},{"type":"heading","depth":2,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Complete C program","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"ekhR3UQ41i"}],"identifier":"complete-c-program","label":"Complete C program","html_id":"complete-c-program","implicit":true,"key":"mX9eArQRGj"},{"type":"code","lang":"c","value":"#include <stdio.h>\n#include <stdlib.h>\n\ndouble average(const double values[], int n) {\n    double sum = 0.0;\n\n    for (int i = 0; i < n; ++i) {\n        sum += values[i];\n    }\n\n    return sum / n;\n}\n\nint main(int argc, char *argv[]) {\n    if (argc != 3) {\n        fprintf(stderr, \"Usage: %s <input_file> <output_file>\\n\", argv[0]);\n        return EXIT_FAILURE;\n    }\n\n    FILE *input_file = fopen(argv[1], \"r\");\n    if (input_file == NULL) {\n        fprintf(stderr, \"Error opening input file '%s'.\\n\", argv[1]);\n        return EXIT_FAILURE;\n    }\n\n    int n;\n    char dataset_name[100];\n    if (fscanf(input_file, \"%d %99s\", &n, dataset_name) != 2 || n <= 0) {\n        fprintf(stderr, \"Invalid input header.\\n\");\n        fclose(input_file);\n        return EXIT_FAILURE;\n    }\n\n    int *points_id = malloc(n * sizeof *points_id);\n    double *points_x = malloc(n * sizeof *points_x);\n    double *points_y = malloc(n * sizeof *points_y);\n    double *points_z = malloc(n * sizeof *points_z);\n\n    if (points_id == NULL || points_x == NULL ||\n        points_y == NULL || points_z == NULL) {\n        fprintf(stderr, \"Could not allocate memory for the points.\\n\");\n        free(points_id);\n        free(points_x);\n        free(points_y);\n        free(points_z);\n        fclose(input_file);\n        return EXIT_FAILURE;\n    }\n\n    /* The remaining input is assumed to follow the format shown above. */\n    for (int i = 0; i < n; ++i) {\n        fscanf(input_file, \"%d %lf %lf %lf\",\n               &points_id[i], &points_x[i],\n               &points_y[i], &points_z[i]);\n    }\n    fclose(input_file);\n\n    double centroid_x = average(points_x, n);\n    double centroid_y = average(points_y, n);\n    double centroid_z = average(points_z, n);\n\n    /* Open the output only after the input has been read. */\n    FILE *output_file = fopen(argv[2], \"w\");\n    if (output_file == NULL) {\n        fprintf(stderr, \"Error opening output file '%s'.\\n\", argv[2]);\n        free(points_id);\n        free(points_x);\n        free(points_y);\n        free(points_z);\n        return EXIT_FAILURE;\n    }\n\n    fprintf(output_file, \"Dataset: %s\\n\", dataset_name);\n    fprintf(output_file, \"Number of points: %d\\n\", n);\n    fprintf(output_file, \"Centroid: (%.2f, %.2f, %.2f)\\n\",\n            centroid_x, centroid_y, centroid_z);\n    fprintf(output_file, \"Point coordinates:\\n\");\n\n    for (int i = 0; i < n; ++i) {\n        fprintf(output_file, \"Point %d: (%.2f, %.2f, %.2f)\\n\",\n                points_id[i], points_x[i],\n                points_y[i], points_z[i]);\n    }\n\n    fclose(output_file);\n    free(points_id);\n    free(points_x);\n    free(points_y);\n    free(points_z);\n\n    printf(\"Centroid written to %s\\n\", argv[2]);\n    return EXIT_SUCCESS;\n}","position":{"start":{"line":68,"column":1},"end":{"line":162,"column":1}},"key":"K63RxPTGTH"},{"type":"heading","depth":2,"position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"Compile and run the program","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"key":"DvX7QptpnH"}],"identifier":"compile-and-run-the-program","label":"Compile and run the program","html_id":"compile-and-run-the-program","implicit":true,"key":"bDcbKcE2M5"},{"type":"paragraph","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"text","value":"Save the code as ","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"I3oUu8REkQ"},{"type":"inlineCode","value":"centroid.c","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"HATtFLhlaY"},{"type":"text","value":", compile it, and run it with the example input:","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"vf8Ns7i5DO"}],"key":"MA0CYClRAd"},{"type":"code","lang":"bash","value":"gcc centroid.c -o centroid\n./centroid poin