:{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Key point: ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"sEG6949rGm"},{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"SIMD pays off most when you keep the inner loop simple","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"MQNjtBiO1L"}],"key":"g9arbrHspd"},{"type":"text","value":" and allow the compiler (or intrinsics) to use FMA (","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"QVdUFBTIyA"},{"type":"inlineCode","value":"fmadd","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"Lq05l5atFo"},{"type":"text","value":") in the polynomial and collision update.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"Q8PXLOV7gy"}],"key":"JhweFN8dDV"},{"type":"heading","depth":3,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Exercise: implement AVX2+FMA collision for D3Q19","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"UgIAlY5gj4"}],"identifier":"exercise-implement-avx2-fma-collision-for-d3q19","label":"Exercise: implement AVX2+FMA collision for D3Q19","html_id":"exercise-implement-avx2-fma-collision-for-d3q19","implicit":true,"key":"T8PdwyAeyJ"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"You will add a new function:","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"zvmXHAPGS2"}],"key":"WeuiQiGfVD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":41,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"collide_d3q19_avx_fma(...)","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"X8BON35WXm"}],"key":"wp8tNdTAXY"}],"key":"GzhP9qKvg8"}],"key":"WfYQXDr7Fl"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"and benchmark it against your scalar baseline.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"mgl6LQwwVX"}],"key":"DopFGjNjWQ"},{"type":"heading","depth":4,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Required compile flags (x86)","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"ikXJVXMoxn"}],"identifier":"required-compile-flags-x86","label":"Required compile flags (x86)","html_id":"required-compile-flags-x86","implicit":true,"key":"qh8IrtvCpW"},{"type":"code","lang":"bash","value":"gcc -O3 -mavx2 -mfma -ffp-contract=fast lb_d3q19_collision_exercise.c -lm -o lb_avx","position":{"start":{"line":47,"column":1},"end":{"line":49,"column":1}},"key":"WjOJhIQkCS"},{"type":"heading","depth":3,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"AVX2 kernel","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"KAauujKAJM"}],"identifier":"avx2-kernel","label":"AVX2 kernel","html_id":"avx2-kernel","implicit":true,"key":"aUALtDMj6I"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Add this to your file (keep the same ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"v67Zin488T"},{"type":"inlineCode","value":"cx, cy, cz, w","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"ghPlTattLf"},{"type":"text","value":" arrays and SoA layout):","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"rFevS5yAvl"}],"key":"gtAsN6NzrB"},{"type":"code","lang":"c","value":"#if defined(__x86_64__) || defined(_M_X64)\n#include <immintrin.h>\n#endif\n\nvoid collide_d3q19_avx_fma(int N,\n                           double * RESTRICT f_out,\n                           const double * RESTRICT f_in,\n                           double omega)\n{\n#if defined(__x86_64__) || defined(_M_X64)\n    const int VL = 4; // __m256d\n    int i = 0;\n\n    const __m256d vone  = _mm256_set1_pd(1.0);\n    const __m256d vthree = _mm256_set1_pd(3.0);\n    const __m256d vfourp5 = _mm256_set1_pd(4.5);\n    const __m256d vminusp1p5 = _mm256_set1_pd(-1.5);\n\n    const __m256d vomega = _mm256_set1_pd(omega);\n    const __m256d vone_minus_omega = _mm256_set1_pd(1.0 - omega);\n\n    // Vector loop over sites (leave tail + edges to scalar)\n    // We ignore i=0 and i=N-1 boundaries in this collision-only benchmark anyway,\n    // but here collision is local so we can include all i.\n    for (; i + (VL-1) < N; i += VL) {\n\n        __m256d rho = _mm256_setzero_pd();\n        __m256d jx  = _mm256_setzero_pd();\n        __m256d jy  = _mm256_setzero_pd();\n        __m256d jz  = _mm256_setzero_pd();\n\n        // --- moments: sum over q ---\n        for (int q = 0; q < 19; q++) {\n            const double *fq_ptr = &f_in[q*(size_t)N + i];\n            __m256d fq = _mm256_loadu_pd(fq_ptr);\n\n            rho = _mm256_add_pd(rho, fq);\n\n            // Multiply by cx[q], cy[q], cz[q] (each in {-1,0,1})\n            if (cx[q] == 1)      jx = _mm256_add_pd(jx, fq);\n            else if (cx[q] == -1) jx = _mm256_sub_pd(jx, fq);\n\n            if (cy[q] == 1)      jy = _mm256_add_pd(jy, fq);\n            else if (cy[q] == -1) jy = _mm256_sub_pd(jy, fq);\n\n            if (cz[q] == 1)      jz = _mm256_add_pd(jz, fq);\n            else if (cz[q] == -1) jz = _mm256_sub_pd(jz, fq);\n        }\n\n        // ux = jx/rho etc.\n        __m256d inv_rho = _mm256_div_pd(vone, rho);\n        __m256d ux = _mm256_mul_pd(jx, inv_rho);\n        __m256d uy = _mm256_mul_pd(jy, inv_rho);\n        __m256d uz = _mm256_mul_pd(jz, inv_rho);\n\n        // u2 = ux^2 + uy^2 + uz^2\n        __m256d ux2 = _mm256_mul_pd(ux, ux);\n        __m256d uy2 = _mm256_mul_pd(uy, uy);\n        __m256d uz2 = _mm256_mul_pd(uz, uz);\n        __m256d u2  = _mm256_add_pd(_mm256_add_pd(ux2, uy2), uz2);\n\n        // --- collision over q ---\n        for (int q = 0; q < 19; q++) {\n            const double *fq_ptr_in = &f_in[q*(size_t)N + i];\n            double *fq_ptr_out      = &f_out[q*(size_t)N + i];\n\n            __m256d fq = _mm256_loadu_pd(fq_ptr_in);\n\n            // cu = cx*ux + cy*uy + cz*uz  (cx,cy,cz in {-1,0,1})\n            __m256d cu = _mm256_setzero_pd();\n            if (cx[q] == 1)      cu = _mm256_add_pd(cu, ux);\n            else if (cx[q] == -1) cu = _mm256_sub_pd(cu, ux);\n\n            if (cy[q] == 1)      cu = _mm256_add_pd(cu, uy);\n            else if (cy[q] == -1) cu = _mm256_sub_pd(cu, uy);\n\n            if (cz[q] == 1)      cu = _mm256_add_pd(cu, uz);\n            else if (cz[q] == -1) cu = _mm256_sub_pd(cu, uz);\n\n            // Polynomial: p = 1 + 3*cu + 4.5*cu^2 - 1.5*u2\n            __m256d cu2 = _mm256_mul_pd(cu, cu);\n\n            // p = (1 - 1.5*u2) + cu*(3 + 4.5*cu)\n            __m256d p = _mm256_fmadd_pd(vminusp1p5, u2, vone);     // p = 1 + (-1.5)*u2\n            __m256d t = _mm256_fmadd_pd(vfourp5, cu, vthree);      // t = 3 + 4.5*cu\n            p = _mm256_fmadd_pd(cu, t, p);                         // p = p + cu*t\n\n            // feq = w[q] * rho * p\n            __m256d vw = _mm256_set1_pd(w[q]);\n            __m256d feq = _mm256_mul_pd(_mm256_mul_pd(vw, rho), p);\n\n            // f_out = (1-omega)*fq + omega*feq   (use FMA)\n            __m256d outv = _mm256_fmadd_pd(vomega, feq, _mm256_mul_pd(vone_minus_omega, fq));\n            _mm256_storeu_pd(fq_ptr_out, outv);\n        }\n    }\n\n    // scalar tail\n    for (; i < N; i++) {\n        double rho = 0.0, jx = 0.0, jy = 0.0, jz = 0.0;\n        for (int q = 0; q < 19; q++) {\n            double fq = f_in[q*(size_t)N + i];\n            rho += fq;\n            jx += fq * (double)cx[q];\n            jy += fq * (double)cy[q];\n            jz += fq * (double)cz[q];\n        }\n        double ux = jx / rho, uy = jy / rho, uz = jz / rho;\n        double u2 = ux*ux + uy*uy + uz*uz;\n\n        double one_minus_omega = 1.0 - omega;\n        for (int q = 0; q < 19; q++) {\n            double fq = f_in[q*(size_t)N + i];\n            double cu = (double)cx[q]*ux + (double)cy[q]*uy + (double)cz[q]*uz;\n            double p = (1.0 - 1.5*u2) + cu*(3.0 + 4.5*cu);\n            double feq = w[q] * rho * p;\n            f_out[q*(size_t)N + i] = one_minus_omega*fq + omega*feq;\n        }\n    }\n\n    sink += f_out[0*(size_t)N + (N/2)];\n#else\n    // Non-x86 fallback\n    collide_d3q19_fma_friendly(N, f_out, f_in, omega);\n#endif\n}","position":{"start":{"line":55,"column":1},"end":{"line":182,"column":1}},"key":"UlV0b03s0W"},{"type":"paragraph","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"In summary:","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"dNVLQmz0ff"}],"key":"Kod8IkRamf"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":186,"column":1},"end":{"line":192,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"SIMD vectorises ","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"key":"wX9RRboyUt"},{"type":"strong","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"children":[{"type":"text","value":"across sites","position":{"start":{"line":186,"column":1},"end":{"line":186,"column":1}},"key":"TOQMKEbuQw"}],"key":"xrCGdbcFNH"},