(\"Usage: %s input_file output_file\\n\", argv[0]);\n         return 1;\n     }\n \n     /* Open input file */\n     fin = fopen(argv[1], \"r\");\n \n     if (fin == NULL) {\n         printf(\"Error: cannot open input file %s\\n\", argv[1]);\n         return 1;\n     }\n \n     /* Read the 100 data points */\n     for (int i = 0; i < N; i++) {\n         fscanf(fin, \"%lf %lf\", &time[i], &velocity[i]);\n     }\n \n     fclose(fin);\n \n     /* Compute mean velocity */\n     double sum = 0.0;\n \n     for (int i = 0; i < N; i++) {\n         sum += velocity[i];\n     }\n \n     double mean = sum / N;\n \n     /* Compute standard deviation */\n     double sum2 = 0.0;\n \n     for (int i = 0; i < N; i++) {\n         double diff = velocity[i] - mean;\n         sum2 += diff * diff;\n     }\n \n     double std_dev = sqrt(sum2 / N);\n \n     /* Find minimum and maximum */\n     double min = velocity[0];\n     double max = velocity[0];\n \n     for (int i = 1; i < N; i++) {\n \n         if (velocity[i] < min) {\n             min = velocity[i];\n         }\n \n         if (velocity[i] > max) {\n             max = velocity[i];\n         }\n     }\n \n     /* Count values above the mean */\n     int above_mean = 0;\n \n     for (int i = 0; i < N; i++) {\n \n         if (velocity[i] > mean) {\n             above_mean++;\n         }\n     }\n \n     /* Open output file */\n     fout = fopen(argv[2], \"w\");\n \n     if (fout == NULL) {\n         printf(\"Error: cannot open output file %s\\n\", argv[2]);\n         return 1;\n     }\n \n     /* Write summary */\n     fprintf(fout, \"Number of measurements: %d\\n\\n\", N);\n \n     fprintf(fout, \"Mean velocity:     %f\\n\", mean);\n     fprintf(fout, \"Std. deviation:    %f\\n\", std_dev);\n     fprintf(fout, \"Minimum velocity:  %f\\n\", min);\n     fprintf(fout, \"Maximum velocity:  %f\\n\", max);\n     fprintf(fout, \"Values above mean: %d\\n\", above_mean);\n \n     /* Write data and deviation from the mean */\n     fprintf(fout, \"\\n\");\n     fprintf(fout, \"# time        velocity        deviation_from_mean\\n\");\n \n     for (int i = 0; i < N; i++) {\n \n         fprintf(fout, \"%f    %f    %f\\n\",\n                 time[i],\n                 velocity[i],\n                 velocity[i] - mean);\n     }\n \n     fclose(fout);\n \n     return 0;\n }","key":"pJlkiyDD8P"}],"key":"bfD5Ufnh7S"}],"key":"XeK1onFOz8"}],"key":"fPqSJ1UfBy"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Exercises related to arrays and pointers","url":"/exercises-arrays-pointers","group":"Exercises In C And Fortran"},"next":{"title":"Brownian Motion and the Diffusion Coefficient","url":"/exercise-brownian-motion","group":"Exercises In C And Fortran"}}},"domain":"http://localhost:3000"}