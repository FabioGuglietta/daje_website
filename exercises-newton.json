":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"In the ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"CHGP3w2sDe"},{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"main program","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"ItbxSv4DU4"}],"key":"SBuMWpaE3P"},{"type":"text","value":":","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"JQs10RAVWs"}],"key":"IW9jaImWDP"}],"key":"mOpaT4wGHy"}],"key":"RmDOuT8o9E"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":36,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Define two bodies (e.g., Sun and Earth-like)","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"SiEWigndPK"}],"key":"BqQDsBYlw5"}],"key":"oHjicy0qDx"},{"type":"listItem","spread":true,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Simulate motion for 1000 steps with ","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"StwNHcgrfV"},{"type":"inlineCode","value":"dt = 0.01","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"SnGhCJYMR8"}],"key":"Ocmd9dutoz"}],"key":"Wbgibh6hTc"},{"type":"listItem","spread":true,"position":{"start":{"line":38,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Print or store their trajectories","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"AJEKdxzzeg"}],"key":"QdVvJOaTdD"}],"key":"gY7Bt3BC6q"}],"key":"v5l8bex2il"},{"type":"comment","value":"-\n<details>\n  <summary>C code</summary>\n   \n```C\nhello\n```\n</details>\n\n<details>\n  <summary>Fortran code</summary>\n   \n```Fortran\n! planetary_motion.f90\n\nMODULE gravity\n  IMPLICIT NONE\n  PRIVATE\n  PUBLIC :: Body, compute_force, update_body, print_body\n\n  REAL, PARAMETER :: G = 1.0 ! Gravitational constant (arbitrary units)\n\n  TYPE :: Body\n    REAL :: mass\n    REAL :: pos(2)\n    REAL :: vel(2)\n  CONTAINS\n    PROCEDURE :: print => print_body\n  END TYPE Body\n\nCONTAINS\n\n  SUBROUTINE compute_force(b1, b2, fx, fy)\n    TYPE(Body), INTENT(IN) :: b1, b2\n    REAL, INTENT(OUT) :: fx, fy\n    REAL :: dx, dy, r2, r, f\n\n    dx = b2%pos(1) - b1%pos(1)\n    dy = b2%pos(2) - b1%pos(2)\n    r2 = dx**2 + dy**2\n    r = SQRT(r2)\n\n    IF (r2 == 0.0) THEN\n      fx = 0.0\n      fy = 0.0\n    ELSE\n      f = G * b1%mass * b2%mass / r2\n      fx = f * dx / r\n      fy = f * dy / r\n    END IF\n  END SUBROUTINE compute_force\n\n  SUBROUTINE update_body(b, fx, fy, dt)\n    TYPE(Body), INTENT(INOUT) :: b\n    REAL, INTENT(IN) :: fx, fy, dt\n    REAL :: ax, ay\n\n    ax = fx / b%mass\n    ay = fy / b%mass\n\n    b%vel(1) = b%vel(1) + ax * dt\n    b%vel(2) = b%vel(2) + ay * dt\n\n    b%pos(1) = b%pos(1) + b%vel(1) * dt\n    b%pos(2) = b%pos(2) + b%vel(2) * dt\n  END SUBROUTINE update_body\n\n  SUBROUTINE print_body(this,step,unit)\n    CLASS(Body), INTENT(IN) :: this\n    INTEGER, INTENT(IN) :: step\n    WRITE(unit=unit,*) step, this%pos(:), this%vel(:)\n  END SUBROUTINE print_body\n\nEND MODULE gravity\n```\n\n```Fortran\nPROGRAM two_body_sim\n  USE gravity\n  IMPLICIT NONE\n\n  TYPE(Body) :: sun, earth\n  REAL :: fx, fy\n  REAL :: dt\n  INTEGER :: i, nsteps\n  INTEGER :: unit_sun=300, unit_earth=301\n\n  ! Initialize bodies\n  sun%mass = 1000.0\n  sun%pos = [0.0, 0.0]\n  sun%vel = [0.0, 0.0]\n\n  earth%mass = 1.0\n  earth%pos = [1.0, 0.0]\n  earth%vel = [0.0, 6.28]  ! roughly circular orbit\n\n  dt = 0.01\n  nsteps = 10000\n\n  OPEN(unit=unit_sun, file='sun.dat')\n  OPEN(unit=unit_earth, file='earth.dat')\n\n  DO i = 1, nsteps\n    CALL compute_force(earth, sun, fx, fy)\n    CALL update_body(earth, fx, fy, dt)\n    CALL update_body(sun, -fx, -fy, dt)  ! apply equal and opposite force\n\n    IF (MOD(i, 10) == 0) THEN\n      CALL sun%print(i,unit_sun)\n      CALL earth%print(i,unit_earth)\n    END IF\n  END DO\n\nEND PROGRAM two_body_sim\n```\n</details>\n-","key":"dcdPBz1mn0"}],"key":"jfayr1F8xI"}],"key":"G5Gdpnxsir"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Exercises related to arrays and pointers","url":"/exercises-arrays-pointers","group":"Exercises In C And Fortran"},"next":{"title":"Gaussian quadrature","url":"/exercise-gaussian-quadrature","group":"Exercises In C And Fortran"}}},"domain":"http://localhost:3000"}