{"version":3,"kind":"Article","sha256":"b48692139f19fcca06e9493d86e136b01f421b3b39b8a95849d46f457cc9a58e","slug":"fortran-passing-arguments","location":"/src/1-Fundamentals/400-The_Fortran_programming_language_basics/4-Fortran_passing_arguments.md","dependencies":[],"frontmatter":{"title":"Passing arguments in Fortran","content_includes_title":false,"numbering":{"title":{"offset":2}},"exports":[{"format":"md","filename":"4-Fortran_passing_arguments.md","url":"/daje_website/build/4-Fortran_passing_ar-de4f377af9f36510c2d29cb7763e5096.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"We propose another variation of the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b88FkECIQG"},{"type":"link","url":"Fortran_BASIC.md","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"example code","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yes2TOtp6E"}],"urlSource":"Fortran_BASIC.md","key":"fqdY3PCyQD"},{"type":"text","value":".\nIndeed, we now read the number of the trapezoids from the command line, and we ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MrXykbuvv6"},{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"dynamically","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VKf6KkAIVz"}],"key":"UKbUmsFR9g"}],"key":"TkYpMW6QoB"},{"type":"text","value":" allocate the memory to store ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Tn24pZiU4o"},{"type":"inlineCode","value":"x_values","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NRjnctSTXm"},{"type":"text","value":" and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"o5Mu61TssI"},{"type":"inlineCode","value":"f_values","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"esjWL43GpG"},{"type":"text","value":" (if you didn’t read the previous examples, don’t worry: you will easliy understand what these varaibles are):","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"I4LeLlZWRU"}],"key":"GpIUDjJCjt"},{"type":"code","lang":"Fortran","value":"program trapezoidal_integration\n    implicit none\n    real(8) :: a = 0.0d0     ! Lower limit of integration\n    real(8) :: b = 1.0d0     ! Upper limit of integration\n    real(8), allocatable :: x_values(:), f_values(:)\n    integer :: n, i\n    real(8) :: result\n\n    ! Prompt the user for the number of trapezoids\n    print *, \"Enter the number of trapezoids (n):\"\n    read(*,*) n\n\n    ! Check if n is valid\n    if (n <= 0) then\n        print *, \"Error: The number of trapezoids must be a positive integer.\"\n        stop\n    end if\n\n    ! Allocate memory for x_values and f_values arrays\n    allocate(x_values(n), f_values(n))\n\n    ! Call the trapezoidal rule to perform the integration\n    result = trapezoidal_rule(a, b, n, x_values, f_values)\n\n    ! Print the result of the integration\n    print *, \"The integral of f(x) = x^3 from \", a, \" to \", b, \" is approximately: \", result\n\n    ! Optionally, print out the x values and their corresponding f(x) values\n    print *, \"x values and f(x) evaluations:\"\n    do i = 1, n - 1\n        print '(I3, F10.5, F15.5)', i, x_values(i), f_values(i)\n    end do\n\n    ! Free dynamically allocated memory\n    deallocate(x_values, f_values)\n\ncontains\n\n    ! Function to define f(x) = x^3\n    real(8) function f(x)\n        real(8), intent(in) :: x\n        f = x**3\n    end function f\n\n    ! Function to perform the trapezoidal rule\n    real(8) function trapezoidal_rule(a, b, n, x_values, f_values)\n        real(8), intent(in) :: a, b\n        integer, intent(in) :: n\n        real(8), intent(out) :: x_values(n), f_values(n)\n        real(8) :: p, sum\n        integer :: i\n\n        p = (b - a) / real(n)            ! Width of each trapezoid\n        sum = 0.5d0 * (f(a) + f(b))      ! End points contribution\n\n        ! Calculate x values and function evaluations\n        do i = 1, n - 1\n            x_values(i) = a + real(i) * p\n            f_values(i) = f(x_values(i))  ! Store function evaluation\n            sum = sum + f_values(i)\n        end do\n\n        trapezoidal_rule = sum * p        ! Return the integral result\n    end function trapezoidal_rule\n\nend program trapezoidal_integration","position":{"start":{"line":6,"column":1},"end":{"line":73,"column":1}},"key":"gyAuClLdHT"},{"type":"heading","depth":2,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Read command line arguments: ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"BAntyE20XI"},{"type":"inlineCode","value":"read()","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"oyo82iJNya"}],"identifier":"read-command-line-arguments-read","label":"Read command line arguments: read()","html_id":"read-command-line-arguments-read","implicit":true,"key":"R48XFdfcJQ"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"In Fortran, the ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"JNp4tiglIG"},{"type":"inlineCode","value":"read()","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"RrdWpmoeIY"},{"type":"text","value":" statement is used to read input from a source, typically the keyboard (standard input) or a file. It can be used in several forms to capture different types of input.\nIn our exampl