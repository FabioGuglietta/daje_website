       p%id = id\n        p%x = x\n        p%y = y\n        p%z = z\n    end subroutine init_point\n\n    ! Subroutine to print a point\n    subroutine print_point(p)\n        type(Point3D), intent(in) :: p\n        print '(A, I0, A, F5.2, A, F5.2, A, F5.2, A)', &\n              \"Point \", p%id, \": (\", p%x, \", \", p%y, \", \", p%z, \")\"\n    end subroutine print_point\n\nend program point3d_example","position":{"start":{"line":104,"column":1},"end":{"line":155,"column":1}},"key":"i5ObWIJWgq"},{"type":"paragraph","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"Let’s break it down:","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"zE4BagMiLo"}],"key":"sazYp4t3Uw"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":157,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":157,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"Derived Type Definition:","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"Q7VM7yx63U"}],"key":"VoIumY14JE"}],"key":"CEdfcCTPXI"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"We define a custom data type using ","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"vUBThL7eo2"},{"type":"inlineCode","value":"type :: Point3D","position":{"start":{"line":158,"column":1},"end":{"line":158,"column":1}},"key":"iAXWHfC2Fl"},{"type":"text","value":", which groups an integer ","positio