"key":"dgW4jHalKZ"}],"key":"sCwdP88hDf"},{"type":"code","lang":"gdb","value":"(gdb) print arr\n$2 = {-6471, 32767, 100, 0, 4096}\n(gdb) print &arr\n$3 = (int (*)[5]) 0x7fffffffe250","position":{"start":{"line":113,"column":1},"end":{"line":118,"column":1}},"key":"t3FZmMSyPi"},{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"Let’s now go to the next instruction with ","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"OBom9OCkks"},{"type":"inlineCode","value":"next","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"yZrc2JxsBM"},{"type":"text","value":", and print the value of ","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"Ao9aOk13cS"},{"type":"inlineCode","value":"arr[i]","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"RlVXhFXqtk"},{"type":"text","value":" (yes, you can also use variables in your expressions!)","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"cQUaPe11KC"}],"key":"y6ljqa0Urg"},{"type":"admonition","position":{"start":{"line":121,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"ZotHqnc7n9"}],"key":"pJNx8NgIRV"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"IGVpOQh7QX"},{"type":"inlineCode","value":"step","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"fUbaHx2oor"},{"type":"text","value":" goes one step by entering also the execution of the called functions, whereas  ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"ZkSSn1rRyl"},{"type":"inlineCode","value":"next","position":{"start":{"line":121,"