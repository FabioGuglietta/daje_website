{"version":3,"kind":"Article","sha256":"3b499eddb21bb8e1e8408f42e5bff4b71f09de7de9df7257803f2f658497f1b8","slug":"gdb","location":"/src/6-Tools/2-Debuggers_and_typical_problems_that_require_them/1-gdb.md","dependencies":[],"frontmatter":{"title":"GDB","content_includes_title":false,"numbering":{"title":{"offset":2}},"exports":[{"format":"md","filename":"1-gdb.md","url":"/daje_website/build/1-gdb-90a00883ecd18ef1441eea016d302c37.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"GDB, the GNU Debugger, is a powerful tool, which can be used for debugging C, C++, Fortran, or other compiled codes.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"phj0l2DXFh"},{"type":"break","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"tsxJfFqaxd"},{"type":"text","value":"When writing complex applications, bugs such as segmentation faults, memory corruption, or logical errors are often\ndifficult to trace by simply reviewing the code, and debuggers like GDB provide you with a robust interface to control\nprogram execution by running your program, for example, line by line, inspecting variables, following the flow of function calls,\nand observing how your program interacts with memory and data.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"WUD2QhoeEX"}],"key":"GTKRiWCzML"},{"type":"heading","depth":2,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"First steps with GDB","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"pWjvhUNmSD"}],"identifier":"first-steps-with-gdb","label":"First steps with GDB","html_id":"first-steps-with-gdb","implicit":true,"key":"BEruvGDl2U"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children