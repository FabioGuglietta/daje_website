les is not restricted: source code, text files, images, etc. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"TcHP2X98Uo"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"It allows you to revert selected files back to a previous state","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Ywgjon5tuH"}],"key":"ZM3fOmPm95"},{"type":"text","value":", revert the entire project back to a previous state, compare changes over time, see who last modified something that might be causing a problem, who introduced an issue and when, and more. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"IfBqrrqxRe"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Git","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"vtBoTEzOQt"}],"key":"r6M7vE9UCt"},{"type":"text","value":" is the most famous and currently used version control system. We’ll see some basic git functionalities in this lecture.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Wy9z9wFkiA"}],"key":"PoV65ctWtG"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Why Git in summary","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"EkHMAQqquI"}],"identifier":"why-git-in-summary","label":"Why Git in summary","html_id":"why-git-in-summary","implicit":true,"key":"jBo7XI7trO"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":20,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":20,"column":1},"en