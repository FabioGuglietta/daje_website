les is not restricted: source code, text files, images, etc. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"UTLnfCnfFP"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"It allows you to revert selected files back to a previous state","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"IKTY0hgCSs"}],"key":"ZWLHwUttdz"},{"type":"text","value":", revert the entire project back to a previous state, compare changes over time, see who last modified something that might be causing a problem, who introduced an issue and when, and more. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"RoGJ3neN4A"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Git","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"IlJQGYxmeC"}],"key":"a4FXP2Povc"},{"type":"text","value":" is the most famous and currently used version control system. We’ll see some basic git functionalities in this lecture.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"MBDcMFWoxq"}],"key":"UwChCB0kJE"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Why Git in summary","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"AGCJ6zfI5y"}],"identifier":"why-git-in-summary","label":"Why Git in summary","html_id":"why-git-in-summary","implicit":true,"key":"ZBLljdIZkS"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":20,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":20,"column":1},"en