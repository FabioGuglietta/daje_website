e":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Parallel development","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"myBdN4m44A"}],"key":"Qy4koSjy7G"},{"type":"text","value":": Work on new features in isolation using branches, and then merge without fear.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"KnmQshsnye"}],"key":"ysUwsqSNK7"}],"key":"gsn8ndCBkM"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"One source of truth","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"VxUcHZzw0a"}],"key":"TXupEhAt7o"},{"type":"text","value":": Everyone sees the same history. No more “which folder did you run that from?”","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"WiPcHesnIj"}],"key":"bPW17qZBgT"}],"key":"Sqk7SgKMFQ"}],"key":"pE9oUWZDMm"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"This lecture expects you to know how to open Terminal in macOS or Linux ~~or Command Prompt or PowerShell in Windows~~. There are a lot of different ways to use Git. There are the original command-line tools, and there are many GUIs. The command line is the only place you can run all Git commands -- most of the GUIs implement only a partial subset of Git functionality for simplicity. If you know how to run the command-line version, you can probably also figure out how to run the GUI version, while the opposite is not necessarily true.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"B5cMiACjRn"}],"key":"RB796nMkEZ"},{"type":"blockquote","position":{"start":{"line":28,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"[!Installation and configuration]","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"xii0PWAK22"}],"key":"l6uWiQJaBN"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The installation of Git will not be covered here. However, Git is so easy to install (e.g. with ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"Cu0WU2sOxU"},{"type":"inlineCode","value":"apt install git","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"yf0R3Tnh6U"},{"type":"text","value":") and famous that it is probably already installed in you machine. Just open a terminal and type ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ZZwoyqX8XV"},{"type":"inlineCode","value":"git --version","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"zLT0wLAcUW"},{"type":"text","value":" to check if it is available.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"m03mKUS6sk"}],"key":"etUJpIDX9I"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Additionally, before using Git, it is good practice to configure a couple of things: your name, email, default text editor and default branch name. This steps will need to be done only once.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"BusKIRP3Bd"}],"key":"RVKgzs0yHI"},{"type":"code","lang":"bash","value":"> git config --global user.name \"John Doe\" # username\n> git config --global user.email johndoe@example.com # useremail\n> git config --global core.editor vim # default text editor\n> git config --global init.defaultBranch main # default branch name","position":{"start":{"line":33,"column":1},"end":{"line":38,"column":1}},"key":"LI7BR3YRBD"}],"key":"rAcCQxCYAG"}],"key":"FhrD4OfyVr"}],"key":"Blvb9QGbbB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Branching","url":"/branching","group":"Git For Version Control"},"next":{"title":"Collaboration and testing","url":"/remote","group":"Git For Version Control"}}},"domain":"http://localhost:3000"}