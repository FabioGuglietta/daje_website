},"key":"BCgt70pL66"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"You don’t know where your actual latest code is. Your teammate Ubaldo (or even worse, YOU!) made changes in their own folder called ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"WYvbK5Tb0m"},{"type":"inlineCode","value":"my_code_Ubaldo_final_v2/","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"bfkXbfDn6g"},{"type":"text","value":" and now your simulations mysteriously produce different results. Welcome to ","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"noNE0NMexf"},{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"folder-based version control","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Rj8zwHEtYc"}],"key":"LnL3CGiWs8"},{"type":"text","value":"! It’s like doing Carbonara with bacon and cream.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"JS3Yggtq2a"}],"key":"wAeGRzIGNe"},{"type":"heading","depth":3,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"What is version control","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"PFXg7YsUQw"}],"identifier":"what-is-version-control","label":"What is version control","html_id":"what-is-version-control","implicit":true,"key":"q9IJFW3cQ3"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"What is “version control”, and why should you care? ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"DiSF88EEI2"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Version control is a system that records changes to a file or set of files over time","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"eqA9ZZKJNl"}],"key":"fXOperx8wh"},{"type":"text","value":" so that you can recall specific versions later. The type of files is not restricted: source code, text files, images, etc. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"NegUqFJ4Ge"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"It allows you to revert selected files back to a previous state","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"y4gTPqbJrK"}],"key":"GWhVh7j0HX"},{"type":"text","value":", revert the entire project back to a previous state, compare changes over time, see who last modified something that might be causing a problem, who introduced an issue and when, and more. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"oEwiTKAXVZ"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Git","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"f1QX3GvyIP"}],"key":"LtHlrydrKU"},{"type":"text","value":" is the most famous and currently used version control system. We’ll see some basic git functionalities in this lecture.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"UItvxu6fMD"}],"key":"k8dyF5VRvl"},{"type":"heading","depth":3,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Why Git in summary","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"ZFFoD1Ip54"}],"identifier":"why-git-in-summary","label":"Why Git in summary","html_id":"why-git-in-summary","implicit":true,"key":"yemBu4zTS3"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line