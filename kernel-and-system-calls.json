olumn":1},"end":{"line":70,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":68,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Once the memory is fully allocated, the operating system usually crashes uncerimoniously. To avoid this issue, modern OSs are often allocating some disk space to function as ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"jXLCVMwach"},{"type":"emphasis","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"virtual","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"LpmTy2jauC"}],"key":"eyD4we50mP"},{"type":"text","value":" memory (also called swap space) that emulates the presence of extra RAM.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"dIQFpbtjqL"}],"key":"xNkQEJneZQ"}],"key":"qDoQzksatc"}],"key":"SvDZ4oZEVv"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"The kernel ensures that each running process has the memory it needs and that no process exceeds its allocated memory. In particular, it handles:","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"LHgL7YErTI"}],"key":"pPdXHPPO6e"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":72,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Memory Allocation: responsible for reserving and releasing memory as processes request it, ensuring there’s no memory leak (unused memory that’s not returned to the system).","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"QqUgMSQOJz"}],"key":"HNTw95Mo21"}],"key":"RegPIONhRF"},{"type":"listItem","spread":true,"position":{"start":{"line":73,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Virtual Memory: swapping inactive memory to disk (in a special area called the swap space) when the system runs low on physical RAM.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"VFYJLaRmjn"}],"key":"odUqAiz3ZI"}],"key":"jYXP0j87yY"}],"key":"cg0WSlYDx7"},{"type":"heading","depth":2,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Device Drivers","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"pqv5eYsn8u"}],"identifier":"device-drivers","label":"Device Drivers","html_id":"device-drivers","implicit":true,"key":"qmkGwmcLZg"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"These are specialized pieces of code that allow the operating system to communicate with hardware devices like printer, network card, or hard drive.\nThe kernel includes a wide range of device drivers, providing also hardware abstraction, so that user programs don’t need to know the details of how\nthe hardware works.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"VUs80ycxaF"}],"key":"xlboVCblpq"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Example: when you write to a file on a hard drive, the kernel takes care of communicating with the drive’s hardware through a device driver.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"I0Tx4T3CDz"}],"key":"LBvRHrMRrk"}],"key":"F5C3CibtHC"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Example: when you type on your keyboard, the kernel uses a keyboard driver to receive the input and pass it along to the appropriate application, like your text editor.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"NmVjCbUxoc"}],"key":"aIKDSLcOxz"}],"key":"BKXZCoIKZx"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"File System Management","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"ONRySL8ZI4"}],"identifier":"file-system-management","label":"File System Management","html_id":"file-system-management","implicit":true,"key":"m4p5rYKCR5"},{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"The Linux kernel provides a unified file system interface that allows you to store and retrieve files from various storage devices, whether they’re local hard drives, SSDs, or\nremote file systems accessed over a network. The kernel supports many types of file systems (like ext4, FAT32, NTFS), which dictate how data is stored and retrieved on disk.\nIt also handles the organization of files into directories and maintains metadata like file permissions, timestamps, and ownership.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"Py050FRCVi"}],"key":"DyFtGOQO0w"},{"type":"paragraph","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Example: When you run the ls command to list files in a directory, the kernel interacts with the file system to retrieve and display this information.","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"Owx3zn7O7v"}],"key":"RFKOKtm4Og"}],"key":"f5XS569DXW"},{"type":"heading","depth":2,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Networking","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"YePu2KS80b"}],"identifier":"networking","label":"Networking","html_id":"networking","implicit":true,"key":"Vq0vpF3GA2"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"The kernel provides implementations of networking protocols (e.g., TCP/IP) that allow computers to communicate over networks, such as the internet.\nThis includes also handling routing of communications, packet filtering (the so-called “firewall”).\nIn particular, the linux kernel provides also a socket interface to user applications, allowing programs to send and receive data over the network as though they were reading from or writing to a file.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"BUCkAKvkqH"}],"key":"XV456iKah6"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"Example: When you load a webpage in your browser, the kernel handles sending requests to the web server and receiving the response over the network.","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"aVbDgnvRbA"}],"key":"wWKna6KDXF"}],"key":"orZ10hGflt"},{"type":"heading","depth":2,"position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Inter-Process Communication (IPC)","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"L3guyrN4CU"}],"identifier":"inter-process-communication-ipc","label":"Inter-Process Communication (IPC)","html_id":"inter-process-communication-ipc","implicit":true,"key":"kHcON1szbj"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"The kernel provides mechanisms for processes to communicate and share data with each other. These mechanisms include pipes, message queues, shared memory, and signals. In particular:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"r5U5qEEIke"}],"key":"a9RJ1OBZZk"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":101,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pipes and Message Queues: allow one process to send data to another and let processes exchange structured messages.","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"sr81in2M7U"}],"key":"ztlygq2HtU"}],"key":"jDnuzdjKPZ"},{"type":"listItem","spread":true,"position":{"start":{"line":102,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Signals: are used to notify processes of asynchronous events, e.g., when a user presses ","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"uNd2rbHBdB"},{"type":"inlineCode","value":"Ctrl+C","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"aLgoImRFHt"},{"type":"text","value":" to terminate a program.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"aqIXqJyOKF"}],"key":"vi1roMQYGq"}],"key":"BTX0iQpPTN"}],"key":"KOVqN02UQL"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Example: When a program like a web server forks a child process to handle a new request, it can use pipes to send data back and forth between the parent and child processes.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"mpWWh4AP4e"}],"key":"pnG1JwG46i"}],"key":"UnxtTbuZsM"},{"type":"heading","depth":2,"position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Security and Access Control","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"X9ouN67P4k"}],"identifier":"security-and-access-control","label":"Security and Access Control","html_id":"security-and-access-control","implicit":true,"key":"NxLDjqShkp"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"The Linux kernel is responsible for ensuring that users and processes can only access the resources they’re allowed to. This includes managing file permissions, user authentication, and process isolation.\nThe kernel enforces user and group-based permissions, ensuring that users can only access the files and devices they’re authorized to.","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"FKaLn7AIYN"}],"key":"NHoe64Gqj9"},{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Example: If you try to delete a system file without the proper permissions, the kernel will prevent you from doing so, protecting the integrity of the system.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"r9CWJvPxjU"}],"key":"lQMRXD5rTN"}],"key":"yy2WrMKdi7"}],"key":"eiflcbsIgQ"}],"key":"Xtdj7BvaWE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introduction to Operating Systems","url":"/unix-and-linux-operating-systems-basic","group":"Introduction To UNIX"},"next":{"title":"The Shell and Basic Unix Commands: Navigating the Unix Shell","url":"/shell-and-basic-unix-commands-pt1","group":"Introduction To UNIX"}}},"domain":"http://localhost:3000"}