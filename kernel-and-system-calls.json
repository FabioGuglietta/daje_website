4,"column":1}},"key":"kGokK9Bc1k"},{"type":"strong","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"storing running programs","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"sMFNzn2kbK"}],"key":"CG6K0OVJih"},{"type":"text","value":" and data.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"HyAJPQS5bP"}],"key":"wOGJrwXhhl"}],"key":"oJr7DJjRL1"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Volatile","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"EW07HqgBIf"}],"key":"dECUJxz5XL"},{"type":"text","value":": contents are lost when power is off.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"rk6qE9idMO"}],"key":"gbeLsN6qUk"}],"key":"RpDIXURprW"},{"type":"listItem","spread":true,"position":{"start":{"line":56,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Measured in gigabytes (GB) in modern systems.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"pWH8KVCeun"}],"key":"PXZeO5YgOE"}],"key":"j7wO5cI7HT"}],"key":"CrkOFHk79s"},{"type":"admonition","position":{"start":{"line":59,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"IP4wpUhvoM"}],"key":"GigSARw3cA"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"As you move up the hierarchy of memory from the registers to RAM/virtual memory:","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"U6Io1jTOvc"}],"key":"BixU01N625"},{"type":"lis