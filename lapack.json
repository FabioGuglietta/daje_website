t":{"line":181,"column":1},"end":{"line":181,"column":1}},"key":"Ni1yEw1JFc"},{"type":"inlineCode","value":"LAPACK_COL_MAJOR","position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"key":"uWyiG4D5Fa"},{"type":"text","value":" is used if the matrix is stored in column-major order (the Fortran default).","position":{"start":{"line":181,"column":1},"end":{"line":181,"column":1}},"key":"S7KZf9OUPk"}],"key":"RDXIAWLBct"}],"kind":"note","class":"simple","key":"gOusl4ZqMY"},{"type":"heading","depth":3,"position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"Below is an example of how to invert a matrix using LAPACK in FORTRAN:","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"ewl2SVBBru"}],"identifier":"below-is-an-example-of-how-to-invert-a-matrix-using-lapack-in-fortran","label":"Below is an example of how to invert a matrix using LAPACK in FORTRAN:","html_id":"below-is-an-example-of-how-to-invert-a-matrix-using-lapack-in-fortran","implicit":true,"key":"wtlGDtE6sW"},{"type":"code","lang":"Fortran","value":"program matrix_inversion\n   implicit none\n   real(8), dimension(2,2) :: A\n   real(8), dimension(2) :: ipiv\n   integer :: info\n\n   ! Matrix A to be inverted\n   A = reshape((/ 4.0d0, 7.0d0, 2.0d0, 6.0d0 /), (/ 2, 2 /))\n\n   ! Call LAPACK routine to perform LU decomposition and matrix inversion\n   call dgetrf(2, 2, A, 2, ipiv, info) ! LU decomposition\n   if (info /= 0) then\n      print *, 'Error in LU decomposition, info = ', info\n      stop\n   endif\n\n   call dgetri(2, A, 2, ipiv, info)    ! Matrix inversion\n   if (info /= 0) then\n      print *, 'Error in matrix inversion, info = ', info\n      stop\n   endif\n\n   print *, 'Inverse of matrix A:'\n   print *, A\nend program matrix_inversion","position":{"start":{"line":186,"column":1},"end":{"line":212,"column":1}},"key":"TBm57Hgenn"}],"key":"dMTU3j2ndY"}],"key":"GMTKklCPSx"},"references":{"cite":{"o