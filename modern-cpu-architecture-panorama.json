:"void add_f64_sve(double *out, const double *a, const double *b, int n) {\n    int i = 0;\n    while (i < n) {\n        svbool_t pg = svwhilelt_b64(i, n);          // predicate active lanes\n        svfloat64_t va = svld1(pg, &a[i]);          // predicated load\n        svfloat64_t vb = svld1(pg, &b[i]);          // predicated load\n        svfloat64_t vc = svadd_f64_z(pg, va, vb);   // predicated add (inactive lanes zeroed)\n        svst1(pg, &out[i], vc);                     // predicated store\n        i += svcntd();                              // advance by #double lanes in a vector\n    }\n}","position":{"start":{"line":174,"column":1},"end":{"line":186,"column":1}},"key":"sarGs03JZz"},{"type":"paragraph","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"children":[{"type":"text","value":"What to notice (conceptually):","position":{"start":{"line":188,"column":1},"end":{"line":188,"column":1}},"key":"W3pYCNHHVz"}],"key":"rWuD9FqXdP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":190,"column":1},"end":{"line":193,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"There is ","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"PaB645UjBp"},{"type":"strong","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"text","value":"no fixed “vector width”","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"JIAGoRi2m6"}],"key":"ZFUvX3Ehii"},{"type":"text","value":" in the source.","position":{"start":{"line":190,"column":1},"end":{"line":190,"column":1}},"key":"ZlqyKztV0M"}],"key":"qMdRRU9uOj"}],"key":"fK36UTpYKh"},{"type":"listItem","spread":true,"position":{"start":{"line":191,"column":1},"end":{"line":191,"column":1}},"children":[{"type":"paragraph","children":[{"typ