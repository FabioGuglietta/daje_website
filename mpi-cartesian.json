c","value":"#include <mpi.h>\n#include <stdio.h>\n\nint main(int argc, char *argv[]) {\n    MPI_Init(&argc, &argv);\n\n    int rank, size;\n    MPI_Comm_rank(MPI_COMM_WORLD, &rank);\n    MPI_Comm_size(MPI_COMM_WORLD, &size);\n\n    int dims[2] = {3, 2};\n    MPI_Dims_create(size, 2, dims);  // Automatically calculate grid dimensions\n\n    int periods[2] = {1, 0};  // Periodic in the first dimension\n    MPI_Comm cart_comm;\n    MPI_Cart_create(MPI_COMM_WORLD, 2, dims, periods, 0, &cart_comm);\n\n    int coords[2];\n    MPI_Cart_coords(cart_comm, rank, 2, coords);\n    printf(\"Rank %d -> Coordinates (%d, %d)\\n\", rank, coords[0], coords[1]);\n\n    int source, dest;\n    MPI_Cart_shift(cart_comm, 0, 1, &source, &dest);\n    printf(\"Rank %d -> Source = %d, Dest = %d\\n\", rank, source, dest);\n\n    MPI_Comm_free(&cart_comm);\n    MPI_Finalize();\n    return 0;\n}","position":{"start":{"line":102,"column":1},"end":{"line":132,"column":1}},"key":"gD9ATHXs8G"},{"type":"thematicBreak","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"kU3fpPCspo"},{"type":"heading","depth":3,"position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"strong","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"Summary Table","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"fZMeN1vjAi"}],"key":"dnGdjjcnVD"}],"identifier":"summary-table","label":"Summary Table","html_id":"summary-table","implicit":true,"key":"xVhbOzKJeh"},{"type":"table","position":{"start":{"line":138,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"strong","position":{"start":{"line":138,"column":1},"end":{"line":138,"column