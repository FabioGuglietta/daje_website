tus)) {\n        printf(\"parent: child exited normally, code=%d\\n\", WEXITSTATUS(status));\n    } else if (WIFSIGNALED(status)) {\n        printf(\"parent: child killed by signal %d\\n\", WTERMSIG(status));\n    } else {\n        printf(\"parent: child ended in an unusual way (status=0x%x)\\n\", status);\n    }\n\n    return 0;\n}","position":{"start":{"line":12,"column":1},"end":{"line":49,"column":1}},"key":"NfUPJZOr1z"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"The code first spawns a new process with ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"qhqpFhNK2n"},{"type":"inlineCode","value":"fork()","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"jexb5dVXda"},{"type":"text","value":":","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"kSYknrqrlq"}],"key":"oJai5tr0Vt"},{"type":"code","lang":"C","value":"    pid_t pid = fork();","position":{"start":{"line":53,"column":1},"end":{"line":55,"column":1}},"key":"XROyG0cX05"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"If something goes wrong (e.g., exceeding the number of allowed processes or memory limits) the kernel sets the value of the variable ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"TvJ72ZJnu5"},{"type":"inlineCode","value":"errrno","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"hsf12USeLA"},{"type":"text","value":"\nto that of the specific error, and -1 is stored in ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"CuQCDQV5tA"},{"type":"inlineCode","value":"pid","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"mca23ZVDvn"},{"type":"text","value":". In this case we can use ","position":{"start":{"line":57,"column":1