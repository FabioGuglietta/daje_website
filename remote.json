e of the commit\"\n\n# update the remote repository state: this is useful to\n# check if someone modified the remote.\ngit fetch\n\n# change branch to <branch_name> (point HEAD to the\n# branch <branch_name>)\ngit checkout <branch_name>\n\n# reset (softly or hardly) to a certain commit hash\n# or to a certain commit pointed by <branch_name>\ngit reset <commit_hash|branch_name>\ngit reset --hard <commit_hash|branch_name>\n\n# pull new commits to the current branch (the branch to\n# which HEAD points to) from the remote branch <branch_name>\ngit pull origin <branch_name>\n\n# push new commits from the current branch (the branch to\n# which HEAD points to) to the remote branch <branch_name>\ngit push origin <branch_name>\n\n# rebase the current branch to the branch <branch_name>\ngit rebase <branch_name>\n\n# merge the branch <branch_name> to the current branch\n# WARNING: remember to do this only if the branch\n# <branch_name> is based on your current commit (no\n# divergent history). If this is not the case, first\n# rebase the branch <branch_name> to the current branch.\ngit merge <branch_name>\n\n# commit the file changes of commit <commit_hash> to\n# the current branch. It's useful if you want to apply\n# the edits of a specific commit to another branch.\ngit cherry-pick <commit_hash>\n","position":{"start":{"line":251,"column":1},"end":{"line":297,"column":1}},"key":"lhYg7p5SB6"}],"key":"XOFYXmlFxS"}],"key":"GvOa1pC3fF"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Git - Version Control System","url":"/introduction-7","group":"Git For Version Control"},"next":{"title":"VIM: A Very Short Introduction","url":"/vim-veryshort","group":"Text Editors"}}},"domain":"http://localhost:3000"}