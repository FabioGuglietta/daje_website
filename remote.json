ol) {\n      return c;\n    }\n    if (f(a) * f(c) < 0) {\n      b = c;\n    } else {\n      a = c;\n    }\n  }\n  // Return the best guess if\n  // max iterations are reached\n  return (a + b) / 2;\n}","position":{"start":{"line":19,"column":1},"end":{"line":44,"column":1}},"key":"VFGwzF4rg0"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"inlineCode","value":"bisection.h","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"eEqFPfJzG6"}],"key":"JoTLehoQmv"},{"type":"code","lang":"c","value":"double bisection(\n  double (*f)(double),\n  double a,\n  double b,\n  double tol,\n  int max_iter);","position":{"start":{"line":46,"column":1},"end":{"line":53,"column":1}},"key":"NPF5xxK26P"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Before going ahead to use this function, let’s create a ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"iNS3AEBBR4"},{"type":"strong","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"unit test","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"jeUzbsIGGg"}],"key":"V2VHrE1jln"},{"type":"text","value":" for it. A ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"utwq8Sctlv"},{"type":"strong","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"unit test","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"risj4LG2zv"}],"key":"K1cbYvYN4l"},{"type":"text","value":" is a small, isolated test that verifies the functionality of a specific part of the code, usually a single function. It checks if the code behaves as expected under defined conditions. Let’s create three unit tests:","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"a3Jgf8xuHl"}],"key":"o6C9MD2jH0"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"inlineCode","value":"test_bisection.c","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"tDChM15hQ8"}],"key":"kgDy0ENN5m"},{"type":"code","lang":"c","value":"#include <stdio.h>\n#include <assert.h>\n#include <math.h>\n#include \"bisection.h\"\n\n// Example function: x^2 - 2\ndouble f(double x) {\n    return x * x - 2;\n}\n\n// Test function for bisection method\nvoid test_bisection_root() {\n    double root = bisection(f, 0, 2, 1e-10, 1000);\n    printf(\"Test 1: Checking if root is close to sqrt(2)...\\n\");\n    assert(fabs(root - sqrt(2)) < 1e-10);  // Root should be close to sqrt(2)\n    printf(\"Test 1 passed 👌.\\n\");\n}\n\n// Test case where the function has no root in the interval\nvoid test_bisection_no_solution() {\n    double root = bisection(f, 1, 1.5, 1e-5, 100);\n    printf(\"Test 2: Checking if root is within the interval [1, 1.5]...\\n\");\n    assert(root >= 1 && root <= 1.5);\n    printf(\"Test 2 passed 👌.\\n\");\n}\n\n// Test case with root at the interval's boundary\nvoid test_bisection_edge_case() {\n    double root = bisection(f, sqrt(2.)-1.e-10, 2, 1e-8, 100);\n    printf(\"Test 3: Checking if root is close to sqrt(2) in small interval...\\n\");\n    assert(fabs(root - sqrt(2)) < 1e-8);\n    printf(\"Test 3 passed 👌.\\n\");\n}\n\nint main() {\n    test_bisection_root();\n    test_bisection_no_solution();\n    test_bisection_edge_case();\n\n    printf(\"All tests passed 👌🏞️🏖️🚀.\\n\");\n    return 0;\n}","position":{"start":{"line":58,"column":1},"end":{"line":101,"column":1}},"key":"YfA4x8UsRZ"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"These tests check that the function behaves as expected in three different situations. Let’s compile everything and check if it works","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"CUWrsQEeUC"}],"key":"wrO5sRnILj"},{"type":"code","lang":"bash","value":"> cc -c bisection.c\n> cc -o test_bisection test_bisection.c bisection.o -lm\n> ./test_bisection\nTest 1: Checking if root is close to sqrt(2)...\nTest 1 passed 👌.\nTest 2: Checking if root is within the interval [1, 1.5]...\nTest 2 passed 👌.\nTest 3: Checking if root is close to sqrt(2) in small interval...\nTest 3 passed 👌.\nAll tests passed 👌🏞️🏖️🚀.","position":{"start":{"line":103,"column":1},"end":{"line":114,"column":1}},"key":"a0guvRLCLb"},{"type":"paragraph","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"Every test passed, so now you can commit to main. ","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"IODFXD3UT5"},{"type":"strong","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"In the future, when adding other commits, before pushing to main you have to make sure that all tests pass, even the one of past features","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"qdHMWr8iFp"}],"key":"qWsoPLNSGo"},{"type":"text","value":". Otherwise you are undoing the work of your past self, or someone else.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"h4gkE6sYT7"}],"key":"QeyLK4lUiX"},{"type":"heading","depth":2,"position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"Workflow in Practice","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"xbg00HUnpX"}],"identifier":"workflow-in-practice","label":"Workflow in Practice","html_id":"workflow-in-practice","implicit":true,"key":"Ieq37vfMk2"},{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"tex