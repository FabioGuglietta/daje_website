{"version":3,"kind":"Article","sha256":"48b21bc9f01053a2bfc86f29c78720319e1f6b1591a438b158ee29c8aa309dec","slug":"scaling","location":"/src/4-HPC/3-CUDA/4-scaling.md","dependencies":[],"frontmatter":{"title":"Scaling","content_includes_title":false,"github":"https://github.com/Marcello-Sega/daje","numbering":{"title":{"offset":3}},"source_url":"https://github.com/Marcello-Sega/daje/blob/main/src/4-HPC/3-CUDA/4-scaling.md","edit_url":"https://github.com/Marcello-Sega/daje/edit/main/src/4-HPC/3-CUDA/4-scaling.md","thumbnail":"/daje_website/build/cuda_scaling-a6bef3d0cafd460a2011e6fc1fc10b25.png","thumbnailOptimized":"/daje_website/build/cuda_scaling-a6bef3d0cafd460a2011e6fc1fc10b25.webp","exports":[{"format":"md","filename":"4-scaling.md","url":"/daje_website/build/4-scaling-9948bf53624b4fb865bffcca7cee7b31.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Consider the following code parallelised with CUDA C.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sKVjE8bPA8"}],"key":"gPoH5WDCMo"},{"type":"code","lang":"C","value":"#include <stdio.h>\n#include <stdlib.h>\n#include <cuda.h>\n#include <time.h>\n\n//#define N 1024  // Matrix size\n\n// Kernel for matrix multiplication\n__global__ void matrix_multiply_kernel(double *A, double *B, double *C, int size) {\n    int row = blockIdx.y * blockDim.y + threadIdx.y; // Row index\n    int col = blockIdx.x * blockDim.x + threadIdx.x; // Column index\n\n    if (row < size && col < size) {\n        double sum = 0.0;\n        for (int k = 0; k < size; k++) {\n            sum += A[row * size + k] * B[k * size + col];\n        }\n        C[row * size + col] = sum;\n    }\n}\n\nint main(int argc, char* argv[]) {\n    double *A, *B, *C;           // Host pointers\n    double *d_A, *d_B, *d_C;     // Device pointers\n    clock_t start, end;\n    double cpu_time_used;\n\n    cudaDeviceProp prop;\n    cudaGetDeviceProperties(&prop, 0);\n\n    if (argc < 4) {\n      printf(\"Usage: %s <N> <blockDim.x> <blockDim.y>:\\n\", argv[0]);\n      printf(\"<N> in the number of rows and columns (NxN matrix)\\n\");\n      printf(\"<blockDim.x> is the number of threads in the block (x direction)\\n\");\n      printf(\"<blockDim.y> is the number of threads in the block (y direction)\\n\");\n      return 1;\n    }\n\n    int N = atoi(argv[1]);\n    int block_dim_x = atoi(argv[2]);\n    int block_dim_y = atoi(argv[3]);\n\n    if(block_dim_x*block_dim_y>prop.maxThreadsPerBlock){\n      printf(\"Max threads per block: %d\\n\", prop.maxThreadsPerBlock);\n      printf(\"You chose %d x %d = %d threads\\n\", block_dim_x, block_dim_y, block_dim_x*block_dim_y);\n      return 1;\n    }\n\n    size_t matrix_size = N * N * sizeof(double);\n\n    // Allocate memory on the host\n    A = (double*) malloc(matrix_size);\n    B = (double*) malloc(matrix_size);\n    C = (double*) malloc(matrix_size);\n\n    // Initialize matrices (example initialization)\n    for (int i = 0; i < N * N; i++) {\n        A[i] = 0.01*i;\n        B[i] = 0.025*i;\n    }\n\n    // Allocate memory on the device\n    cudaMalloc((void**)&d_A, matrix_size);\n    cudaMalloc((void**)&d_B, matrix_size);\n    cudaMalloc((void**)&d_C, matrix_size);\n\n    // Copy matrices A and B from host to device\n    cudaMemcpy(d_A, A, matrix_size, cudaMemcpyHostToDevice);\n    cudaMemcpy(d_B, B, matrix_size, cudaMemcpyHostToDevice);\n\n    // Define grid and block dimensions\n    dim3 blockDim(block_dim_x, block_dim_y);\n    dim3 gridDim((N + blockDim.x - 1) / blockDim.x, (N + blockDim.y - 1) / blockDim.y);\n\n    // Start timing\n    start = clock();\n\n    // Launch kernel\n    matrix_multiply_kernel<<<gridDim, blockDim>>>(d_A, d_B, d_C, N);\n\n    // Wait for the GPU to finish\n    cudaError_t err = cudaDeviceSynchronize();\n    if (err != cudaSuccess) {\n      printf(\"Kernel execution failed: %s\\n\", cudaGetErrorString(err));\n    }\n\n    // Stop timing\n    end = clock();\n    cpu_time_used = ((double) (end - start)) / CLOCKS_PER_SEC;\n\n    // Copy result matrix C from device to host\n    cudaMemcpy(C, d_C, matrix_size, cudaMemcpyDeviceToHost);\n\n    //printf(\"Matrix multiplication completed in %.2f ms\\n\", cpu_time_used * 1000);\n    printf(\"%d %d %d %.6f\\n\", N, block_dim_x, block_dim_y, cpu_time_used);\n\n    // Free memory on device\n    cudaFree(d_A);\n    cudaFree(d_B);\n    cudaFree(d_C);\n\n    // Free memory on host\n    free(A);\n    free(B);\n    free(C);\n\n    return 0;\n}","position":{"start":{"line":5,"column":1},"end":{"line":114,"column":1}},"key":"WMpkC6F76F"},{"type":"paragraph","position":{"start":{"line":116,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"In this code, we vary the size ","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"mT2oLkMx4s"},{"type":"inlineCode","value":"N","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"agq9kT9mRm"},{"type":"text","value":" and the number of threads per block, both along x and y (","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"IB246YxGav"},{"type":"inlineCode","value":"block_dim_x","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"YTd8W9QqkU"},{"type":"text","value":" and ","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"YksRY5UQGg"},{"type":"inlineCode","value":"block_dim_y","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"l3KXMVXX49"},{"type":"text","value":"). Note that the times are taken right before the call to the kernel ","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"m0bHRcIr2b"},{"type":"inlineCode","value":"matrix_multiply_kernel","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"yeIwPCCzla"},{"type":"text","value":" and after the call to ","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"voQyFR1XtW"},{"type":"inlineCode","value":"cudaDeviceSynchronize()","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"Jm2cLXT2ma"},{"type":"text","value":".\nThis last call is crucial, because ","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"NptGPsK7jW"},{"type":"strong","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","value":"kernel launches are asynchronous","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"Hd0Z9y3vU5"}],"key":"pn6VGdmQW7"},{"type":"text","value":", meaning that the host (CPU) does not wait for the kernel execution on the device (GPU) to finish before continuing to the next line of code. If you measure time immediately after launching a kernel without waiting for its completion, the measured time will not accurately reflect the kernel’s execution duration.","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"Zb104LRWIh"}],"key":"WdyocLLlkc"},{"type":"admonition","position":{"start":{"line":119,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"JOQISv126Q"}],"key":"jH3GwvE05B"},{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"RKxqTGhaAS"}],"key":"HjpQLlwny0"},{"type":"heading","depth":2,"position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"Kernel execution and ","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"SrSQrlzOO6"},{"type":"inlineCode","value":"cudaDeviceSynchronize()","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"DkhcPR5h5l"}],"identifier":"kernel-execution-and-cudadevicesynchronize","label":"Kernel execution and cudaDeviceSynchronize()","html_id":"kernel-execution-and-cudadevicesynchronize","implicit":true,"key":"mPeCfogsKl"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"When you invoke a CUDA kernel (like ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"cIBOtbKJ4Y"},{"type":"inlineCode","value":"matrix_multiply_kernel<<<gridDim, blockDim>>>()","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"JzGdD2edCl"},{"type":"text","value":"), the kernel is queued for execution but the ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"zWYNWgQBik"},{"type":"strong","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"host does not block or wait for it to complete","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"fDaJMl6tKI"}],"key":"tEkAzA9q6d"},{"type":"text","value":". Without ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"dgFP8RVwSS"},{"type":"inlineCode","value":"cudaDeviceSynchronize","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"buNinmJWDB"},{"type":"text","value":", the ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"o19B1OdVZq"},{"type":"inlineCode","value":"clock()","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"RyNcKzeIVk"},{"type":"text","value":" call to stop timing may occur before the kernel has finished executing, leading to incorrect timing. ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"iH53OTSquD"},{"type":"inlineCode","value":"cudaDeviceSynchronize()","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"UUd9Be8Ro5"},{"type":"text","value":" forces the host to wait until all preceding GPU work (including the kernel) is completed. ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"W2ENehVYI3"},{"type":"inlineCode","value":"cudaDeviceSynchronize()","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"EeewuoZAL3"},{"type":"text","value":" also provides an opportunity to check for errors during kernel execution: if there is an issue (e.g., out-of-bounds memory access), the error can be detected and reported immediately after synchronization.","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"GNxYiUxH1c"}],"key":"XEs8m8q4X0"}],"kind":"note","class":"simple","key":"BRyBtz81dp"},{"type":"paragraph","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"Here a bash script that can be used to run multiple times the above code varying the input parameters:","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"aCWO7dmcru"}],"key":"U53WPTsLcE"},{"type":"code","lang":"bash","value":"#!/bin/bash\n\n# Define the values of N to iterate over\nNs=(1024 2048 4096)\n\n# Define the thread counts for nx and ny\nthread_values=(1 2 4 8 16 32 64 128 256 512 1024)\n\n# Loop over each N\nfor N in \"${Ns[@]}\"; do\n\n    # Vary nx with ny fixed to 1\n    for nx in \"${thread_values[@]}\"; do\n        ny=1\n        if (( nx * ny < 1024 )); then\n            ./scaling.exe $N $nx $ny \n        fi  \n    done\n\n    # Vary ny with nx fixed to 1\n    for ny in \"${thread_values[@]}\"; do\n        nx=1\n        if (( nx * ny < 1024 )); then\n            ./scaling.exe $N $nx $ny \n        fi  \n    done\n\n    # Vary nx and ny equally\n    for nx in \"${thread_values[@]}\"; do\n        ny=$nx\n        if (( nx * ny < 1024 )); then\n            ./scaling.exe $N $nx $ny \n        fi  \n    done\ndone","position":{"start":{"line":125,"column":1},"end":{"line":161,"column":1}},"key":"eIRZalca3m"},{"type":"paragraph","position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"children":[{"type":"text","value":"This is the scaling plot:","position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"key":"ZUNOCBQkJZ"}],"key":"B2Qr8aZ39Z"},{"type":"image","url":"/daje_website/build/cuda_scaling-a6bef3d0cafd460a2011e6fc1fc10b25.png","alt":"plot","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"TurlDWG0rW","urlSource":"cuda_scaling.png","urlOptimized":"/daje_website/build/cuda_scaling-a6bef3d0cafd460a2011e6fc1fc10b25.webp"},{"type":"paragraph","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"The plateau observed in execution time as we increase the number of threads along the x-direction in the matrix-matrix multiplication kernel is due to the ","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"stszzgBUvx"},{"type":"strong","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"saturation of computational resources","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"FXnrOxC3QG"}],"key":"wXOF7HM0pZ"},{"type":"text","value":" and the characteristics of GPU hardware. Here’s why this happens:","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"dGltwQfq3W"}],"key":"NG1tnMAXwS"},{"type":"heading","depth":2,"position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"1. Maximum Occupancy of GPU Resources","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"RuS1fISCjG"}],"identifier":"id-1-maximum-occupancy-of-gpu-resources","label":"1. Maximum Occupancy of GPU Resources","html_id"