{"version":3,"kind":"Article","sha256":"1532646449106adcacb23144d0c324493b844277b279118381bf2e7098cca3b6","slug":"x86-history","location":"/src/2-Advanced/100-Know_your_machine/4-x86_history.md","dependencies":[],"frontmatter":{"title":"The architecture of a CPU","content_includes_title":false,"github":"https://github.com/Marcello-Sega/daje","numbering":{"title":{"offset":3}},"source_url":"https://github.com/Marcello-Sega/daje/blob/main/src/2-Advanced/100-Know_your_machine/4-x86_history.md","edit_url":"https://github.com/Marcello-Sega/daje/edit/main/src/2-Advanced/100-Know_your_machine/4-x86_history.md","exports":[{"format":"md","filename":"4-x86_history.md","url":"/daje_website/build/4-x86_history-ddfc14f5d7577fda9e919843e2cc412e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"If you’re using a modern personal computer in the 2020s, it’s likely that you’re using a\nCPU with either x86-64 or ARM architecture. By architecture (more precisely an instruction set architecture, or ISA),\nwe mean a standard set of rules that define the way a CPU is supposed to be composed and behave. The ISA defines, for example the set\nof instructions (addition, subtraction, ...) , data types (integers, floating points and their representation) and memory\n(registers and addresses, memory management system, ...).\nOf course, every CPU manufacturer has usually several implementations of a specific ISA, and they are called\nmicroarchitecture.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"i2arIiaTDF"}],"key":"QunYFOw0v8"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"In the following we restrict our discussion and historical overview to Intel-compatible architectures only.\nExamples of architectures, microarchitectures and CPUs you might have heard of include:","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"roRhtauWUI"}],"key":"CeRjMQHUww"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":14,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"x86-16 architecture","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"ZtJSLObanF"}],"key":"PSyg9RsHd4"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel 8086","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"UOYmF6NVKt"}],"key":"tDt6ZfyTme"}],"key":"sIsYqFt8Cv"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel 80286","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"GDFmiN43fx"}],"key":"WS66vG657N"}],"key":"zIZXsYsU9v"}],"key":"VggvbFZvPu"}],"key":"WsgO6EzORk"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"IA-32","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"NtWoOs9kZK"}],"key":"mpXdLx9Yl7"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":18,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel 80386","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"Gex7AcXHQr"}],"key":"IrZPPwqg00"}],"key":"VzjoOYeS4D"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel 80486","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"S2cfRVtfRK"}],"key":"H7ixFZEQl4"}],"key":"hJAzPbcDqr"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel Pentium","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"OHtOKCqdAk"}],"key":"WS6ZX4ycdK"}],"key":"gRfNtUX6Tw"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"AMD K6","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"YyWfsJYQb2"}],"key":"YNpTp9HrsZ"}],"key":"dRBU5FGzlR"}],"key":"c9uRvXicOs"}],"key":"GQPRPQmGWw"},{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"IA-64","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"RvvM4T1B4d"}],"key":"VhUgfy6lj2"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel Itanium","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Vif8qUGuSf"}],"key":"s9ipoggdM5"}],"key":"RBLkefkMVs"}],"key":"gCPPxRH6xs"}],"key":"neozpC1S0i"},{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"x86-64","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"Gltb7OAfEl"}],"key":"uk9BFuyIzi"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":25,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel Core i5 (Haswell)","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"FXZL1QirZN"}],"key":"yqNgft1tpH"}],"key":"vSFROHW7rA"},{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel Core i7 (Broadwell)","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ibb7Venmqd"}],"key":"idOh1Kn6Ma"}],"key":"By3XSamjF8"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel Skylake","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"q5Kzee3FtB"}],"key":"gUtcVXfPz3"}],"key":"wQdvh7RpDJ"},{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"AMD Ryzen","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Pl9aMxYLP8"}],"key":"bxTHCcl7G2"}],"key":"Qh5CQdGkaA"},{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"AMD Epyc (Zen microarchitecture family)","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"tFtRN3V4WX"}],"key":"M2samvouiI"}],"key":"PCSYw4jSkU"}],"key":"EUCxHuQ4tS"}],"key":"yyOM3M55c5"}],"key":"Qhz5b8PtWi"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"We can say that a specific microarchitecture is the description of the specific components of a CPU,\nand entails concepts like those of arithmetic logic unit (ALU), Floating Point Unit (FPU), instruction sets, pipelines, cache,\nbranch predictors, multithreading, and more.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"XzrOMc5Fp1"}],"key":"PVrGcnSXnV"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"We will focus on Intel architectures, but our discussion is rather general in terms of modern CPU architectures.\nIf you are interested in historical development of different architectural philosophies, you might want to explore,\nfor example","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"e73rQVASfw"}],"key":"M0iB7HP5iK"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Reduced Instruction Set Computers (RISC) vs Complex Instruction Set Computers (CISC)","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"JTIw4Gvzjw"}],"key":"Q0omPOKr3I"}],"key":"azHoXfcI1u"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Scalar processors vs Vector processors","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ryXAuC36cC"}],"key":"tackVvx5YQ"}],"key":"zVQpafaSSe"}],"key":"yhMbFfb2sD"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Most modern (2020s) CPUs are CISC/RISC hybrids, with the CPU receiving CISC instruction but executing them using\nproprietary RISC microinstructions. They are classified as scalar processors because they process finite-size chuncks\nof data, even though this is usually done in a vectorised way with SIMD (single instruction multiple data) units.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"dFiMBitXTE"}],"key":"pYEAdNUIGm"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Now, a bit of history of microprocessors:","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"eZaiB3XWVr"}],"key":"deBbqWprcU"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"The first commercially produced microprocessor was the Intel 4004, a 4-bit CPU based on\nMetal-Oxide-Semiconductor (MOS)  silicon gate technology, designed by Federico Faggin and released in 1971, and it opened\nthe doors to the future of mass-produced, general purpose CPUs. Only few months later, Intel released the first 8-bit\nmicroprocessor, the 8008 (which Intel started developing even before the 4004 hit the market, showing the\ncompany’s appetite to what became the modern microprocessor proliferation). Few years later, in 1978, Intel released the\n8086 and its close cousin, the 8088, the foundation of what we now know as the x86 architecture.\nThe 8088 CPUs were a huge success as they were used in the IBM PC, debuting in 1981, and destined to become one of the more\ninfluential lines of home and office computers, the x86-based architecture being one of the most used nowadays (excluding mobile\ncomputing).","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"bsXOfXm830"}],"key":"VxR5cpDiYz"},{"type":"heading","depth":2,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Intel 8086","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"LteK1fZS7I"}],"identifier":"intel-8086","label":"Intel 8086","html_id":"intel-8086","implicit":true,"key":"FiAKo4eZ3w"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"The 8086 was a 16-bit processor with a few core parts:","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"vkZyMzSaYx"}],"key":"ncOS7oMyT7"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":62,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"ALU (Arithmetic Logic Unit): handles basic math and logic.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"EDru9r52oF"}],"key":"JgsphLb3T2"}],"key":"T6jLSFmpPt"},{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Registers: (named AX, BX, CX, etc.) holding data and memory addresses temporarily.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"xrQOBWBpex"}],"key":"ScfjIgQ4Hb"}],"key":"AUU3OihEaM"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Control Unit: reads and executes instructions, telling the ALU and registers what to do.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"p27CsYc09R"}],"key":"tHiYYhSisG"}],"key":"qH4K2folW7"},{"type":"listItem","spread":true,"position":{"start":{"line":65,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Memory Interface: Addressed up to 1 MB of memory","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"NtrG73YgaH"}],"key":"JgUI7USv8s"}],"key":"aCQErRiNAl"}],"key":"ePhnsY7cp1"},{"type":"heading","depth":2,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Intel 80386","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"oicRY0FkZg"}],"identifier":"intel-80386","label":"Intel 80386","html_id":"intel-80386","implicit":true,"key":"OqbeVUuJ9N"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"The 80386, released in 1985, was a game-changer. It was the first 32-bit processor in the\nx86 family, which meant it could handle more data and address a lot more memory—up to 4 GB.\nThe 80386 could be supplemented by the 80387 floating point unit (FPU) coprocessor. In later CPUs, the\nFPUs were typically integrated on-chip.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"GlZcco0ZNJ"}],"key":"XzLrTqgZNb"},{"type":"heading","depth":2,"position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"i486","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"N5dPWWO4Cj"}],"identifier":"i486","label":"i486","html_id":"i486","implicit":true,"key":"Z2ee3kQpty"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"By 1989, the 80486 (then rebranded i486) brought some serious upgrades.\nIt integrated the Floating Point Unit (FPU) directly into the CPU, making scientific calculations much faster.\nIt also introduced an on-chip cache, which stored frequently used data close to the CPU, speeding up processing by\nreducing the need to fetch data from slower main memory.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"rKUzxAAgPn"}],"key":"GO3woIGVde"},{"type":"heading","depth":2,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"The Pentium Series: Parallel Processing","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"qMuSrGBCX5"}],"identifier":"the-pentium-series-parallel-processing","label":"The Pentium Series: Parallel Processing","html_id":"the-pentium-series-parallel-processing","implicit":true,"key":"LfppLLH9pb"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"The early 1990s saw the arrival of the Pentium series, which introduced a superscalar architecture.\nThis meant the CPU could execute multiple instructions at the same time, thanks to having multiple ALUs and FPUs.\nIt also brought in branch prediction (guessing which way a program will go at a fork) and out-of-order execution\n(rearranging instruction execution to avoid delays), both of which boosted performance.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"pxABFSyEv7"}],"key":"GAnyMx0bu8"},{"type":"heading","depth":2,"position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"The x86-64 architecture","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"QEEFJPOAQw"}],"identifier":"the-x86-64-architecture","label":"The x86-64 architecture","html_id":"the-x86-64-architecture","implicit":true,"key":"ryWT3uCZdu"},{"type":"paragraph","position":{"start":{"line":90,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"The x86-64 architecture was introduced by AMD; Also known as AMD64, it was developed by AMD as an extension of\nIntel’s x86 architecture to support 64-bit computing while maintaining backward compatibility with 32-bit and\n16-bit x86 code, which was lost in the competing 64 bit architecture of Intel (IA-64, Itanium processors).\nEvenually, Intel adopted the AMD64 architecture starting with the Pentium Pro in the mid-1990s.\nThese CPUs feature deep pipelines, sophisticated speculative execution (executing instructions before they’re needed,\nbased on predictions), and multiple levels of cache (L1, L2, and L3) to keep the processor fed with data.\nThese CPUS also introduced MMX (the MultiMedia eXtensions) a type of SIMD (Single Instruction, Multiple Data)\ninstructions able to operate on multiple data points at once","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"peflcFYmr9"}],"key":"XafLbzNNxx"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Building on the success of MMX, Intel introduced SSE (Streaming SIMD Extensions) with the Pentium III.\nSSE expanded SIMD capabilities beyond the integer operations of MMX to include floating-point operations.\nEach new iteration (SSE2, SSE4) added more instructions and improved the performance and versatility to\nthe SIMD units, making it increasingly valuable for a wider range of applications. By the time of SSE4,\nSIMD units were not just a tool for multimedia but also a significant asset in tasks like encryption,\ndata compression, and many aspects of scientific computing.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"QnjTKpvkev"}],"key":"Ogit7Lv4nv"},{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"With AVX (Advanced Vector Extensions), first appearing in Intel’s Sandy Bridge processors in 2011, AVX brought\nwider vector registers (256 bits compared to 128 bits in SSE), allowing the CPU to process even more data in\nparallel. AVX is particularly impactful in areas requiring heavy numerical computation.","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"DiTJcLZSFR"}],"key":"LTTvZzn2fi"},{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"In summary:","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"W6ji3eLYxD"}],"key":"HehQNXJlSq"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":113,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel’s MMX (MultiMedia eXtensions): provides arithmetic and logic operation on 64-bits integer numbers in\nblocks of 2 32-bit, 4 16-bit or 8 8-bit operations in one instruction. Ther registers are called MM0, MM1, ...","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"pJMA85dJiH"}],"key":"kMWVC7iB21"}],"key":"CeCxqn33f0"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"AMD’s 3DNow: added single-precision (32-bit) floating point support to the MMX instruction set","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"tvITHb1VyZ"}],"key":"CIZ9zdQBmZ"}],"key":"fOoVKnUnaK"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel’s SSE (Streaming SIMD Extensions): providing single precision floating point operations and 128-bit registers (XMM0, XMM1,...)","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"X7EFht88qA"}],"key":"zhKavaF0uI"}],"key":"NeM601HJkv"},{"type":"listItem","spread":true,"position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel’s SSE2/SSE4: providing double precision (64-bit) floating point operations on 128-bit registers (","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"hfddaXew7m"}],"key":"KDIpo6t71c"}],"key":"ZC0IxDI4GV"},{"type":"listItem","spread":true,"position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel’s AVX/AVX2 (Advanced Vector Extensions): introduces 256-bit (YMM) registers and wider instructions sets","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"y099akuak0"}],"key":"GcgVJQGaKc"}],"key":"xM6wTs8o6v"},{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Intel’s AVX-512: expands AVX to 512-bit support","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"zzlk7pDC8B"}],"key":"DKY9Q4dUy0"}],"key":"z5kkX3Hm99"}],"key":"D4X9GMDzPW"}],"key":"y6owkYE1rZ"}],"key":"jNWsWli67r"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Handling Roundoff Errors in Scientific Computing","url":"/roundoff","group":"Know Your Machine"},"next":{"title":"Basics of x86-64 assembly language","url":"/x86-assembly","group":"Know Your Machine"}}},"domain":"http://localhost:3000"}